{
  "name": "dsh-delivery-receipts",
  "version": "0.1.0",
  "description": "Session-scoped artifact receipts with file evidence and version-bound user decisions",
  "author": "牛村木木山",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=22" },
  "exports": { ".": "./index.js", "./client": "./client.js", "./package.json": "./package.json", "./locale/*.json": "./locale/*.json" },
  "files": ["index.js", "client.js", "src/", "cordis.patch.yml", "locale/", "README.md", "README.zh.md", "LICENSE", "examples/"],
  "repository": { "type": "git", "url": "https://github.com/piggy00544/dsh-workproof.git", "directory": "packages/dsh-delivery-receipts" },
  "bugs": { "url": "https://github.com/piggy00544/dsh-workproof/issues" },
  "dependencies": { "zod": "4.6.5" },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/dsh-storage-domain": "0.2.0-rc.2",
    "@deepseek-ai/dsh-commands": "0.2.0-rc.2"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "immediately": true, "inject": ["@deepseek-ai/dsh-client-ui-conversation"], "external": [] }
  }
}
